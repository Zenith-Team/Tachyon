{
  "private": true,
  "type": "module",
  "name": "tachyon",
  "version": "5.0.0",
  "main": "dist/main.js",
  "bin": {
    "tachyon": "dist/main.js"
  },
  "scripts": {
    "start": "node dist/main.js",
    "build": "npm run rebuild && npm rm -g tachyon && npm link",
    "rebuild": "npm run clean && npx tsc",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "lint": "npx eslint",
    "lint-fix": "npm run lint -- --fix"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "env-paths": "^4.0.0",
    "json5": "^2.2.3",
    "rpxlib": "^0.9.1",
    "semver": "^7.8.5",
    "which": "^6.0.1",
    "zip-lib": "npm:@jhmaster/zip-lib@^1.3.2-pr.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.4",
    "@types/semver": "^7.7.1",
    "@types/which": "^3.0.4",
    "eslint": "^10.6.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
